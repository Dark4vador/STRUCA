# Copie ce fichier en ".env" et renseigne ta vraie clé.
# Récupère ta clé gratuite sur https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Facultatif: Flash-Lite par défaut (meilleur RPM du tier gratuit,
# largement suffisant pour de l'extraction structurée). Passe à
# gemini-3-flash ou gemini-2.5-pro si besoin de plus de précision
# (attention: Pro est limité à ~50 requêtes/jour en gratuit).
GEMINI_VISION_MODEL=gemini-3.1-flash-lite
GEMINI_REASONING_MODEL=gemini-3.1-flash-lite

# Raisonnement / relecture du devis final (synthèse + avertissements)
# Clé gratuite sur https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_REASONING_MODEL=llama-3.3-70b-versatile
